
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beacon.example/schemas/audit-context-1.0.0.json",
  "title": "Beacon Request Audit Context",
  "description": "Complete structured audit record for one Beacon HTTP request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_schema_version",
    "audit_id",
    "request_id",
    "status",
    "started_at",
    "duration_ms",
    "request",
    "identity",
    "authorization",
    "configuration",
    "budget",
    "database",
    "execution",
    "response",
    "error",
    "runtime",
    "integrity",
    "semantic_action"
  ],
  "properties": {

    "semantic_actions": {
    "type": "array",
    "description": "Semantic actions performed or attempted during the HTTP request.",
    "items": {
      "$ref": "#/$defs/action"
    }
  },
    "audit_schema_version": {
      "const": "1.0.0"
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 8,
      "pattern": "^[a-zA-Z0-9]{8}$"
    },
    "status": {
      "enum": [
        "in_progress",
        "completed",
        "failed",
        "rejected",
        "cancelled",
        "timed_out",
        "interrupted"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "duration_ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "database": {
      "$ref": "#/$defs/database"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "response": {
      "$ref": "#/$defs/response"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "action": {
    "type": "object",
    "description": "Semantic description of the operation requested or performed by the application.",
    "required": [
      "name",
      "category",
      "target",
      "outcome"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "description": "Canonical semantic action identifier, such as dataset.query, patient_record.view or user.role.change."
      },
      "category": {
        "type": "string",
        "enum": [
          "data_access",
          "data_modification",
          "data_export",
          "authentication",
          "authorization",
          "administration",
          "configuration",
          "budget",
          "database",
          "health",
          "system",
          "other"
        ]
      },
      "target": {
        "type": ["object", "null"],
        "properties": {
          "type": {
            "type": ["string", "null"],
            "description": "Type of resource affected or accessed, such as dataset, patient, individual or collection."
          },
          "id": {
            "type": ["string", "null"],
            "description": "Stable identifier of the target resource, when applicable."
          },
          "identifiers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Multiple resource identifiers when the action targets several resources."
          }
        },
        "additionalProperties": false
      },
      "outcome": {
        "type": "string",
        "enum": [
          "pending",
          "success",
          "denied",
          "failed",
          "partial",
          "not_applicable"
        ],
        "description": "Final outcome of the semantic action."
      },
      "reason": {
        "type": ["string", "null"],
        "description": "Explanation of the outcome, particularly for denied or failed actions."
      },
      "attributes": {
        "type": "object",
        "description": "Additional non-sensitive contextual attributes relevant to the semantic action."
      }
    },
    "additionalProperties": false
  },
    "request": {
      "type": "object",
      "required": [
        "method",
        "path",
        "path_parameters",
        "query_parameters",
        "client",
        "body"
      ],
      "properties": {
        "method": {"type": "string"},
        "path": {"type": "string"},
        "route": {"type": ["string", "null"]},
        "path_parameters": {"type": "object"},
        "query_parameters": {"type": "object"},
        "headers": {
          "type": "object",
          "description": "Allowlisted headers only."
        },
        "http_version": {"type": ["string", "null"]},
        "client": {
          "type": "object",
          "required": ["ip", "user_agent"],
          "properties": {
            "ip": {"type": ["string", "null"]},
            "user_agent": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "required": ["present", "size_bytes"],
          "properties": {
            "present": {"type": "boolean"},
            "size_bytes": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "content_hash": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "authenticated",
        "user_id",
        "authentication_method",
        "authentication_status"
      ],
      "properties": {
        "authenticated": {"type": ["boolean", "null"]},
        "user_id": {"type": ["string", "null"]},
        "authentication_method": {"type": ["string", "null"]},
        "authentication_status": {
          "enum": [
            "success",
            "failed",
            "not_required",
            "not_attempted",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "description": "Authorization decisions for datasets requested by the client.",
      "required": [
        "requested_datasets",
        "authorized_datasets",
        "rejected_datasets",
        "decisions"
      ],
      "properties": {
        "requested_datasets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authorized_datasets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected_datasets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dataset",
              "security_level",
              "allowed",
              "requested_granularity",
              "allowed_granularity",
              "effective_granularity",
              "reason"
            ],
            "properties": {
              "dataset": {
                "type": "string"
              },
              "security_level": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "public",
                  "registered",
                  "controlled",
                  null
                ]
              },
              "allowed": {
                "type": "boolean",
                "description": "Whether the permission system authorized access to the dataset."
              },
              "requested_granularity": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "record",
                  "count",
                  "boolean",
                  null
                ]
              },
              "allowed_granularity": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "record",
                  "count",
                  "boolean",
                  null
                ],
                "description": "Maximum granularity permitted by the authorization system."
              },
              "effective_granularity": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "record",
                  "count",
                  "boolean",
                  null
                ],
                "description": "Granularity actually disclosed in the response. Null if no effective response granularity could be established."
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": [
        "api_version",
        "entry_type",
        "source",
        "test_mode",
        "configuration_fingerprint"
      ],
      "properties": {
        "api_version": {"type": ["string", "null"]},
        "requested_schema": {"type": "array"},
        "returned_schema": {"type": "array"},
        "entry_type": {"type": ["string", "null"]},
        "pre_entry_type": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "response_type": {"type": ["string", "null"]},
        "test_mode": {"type": "boolean"},
        "configuration_fingerprint": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },

    "budget": {
      "type": "object",
      "required": [
        "enabled",
        "previous_query_counts",
        "decision"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "enum": ["user", "ip", "global", null]
        },
        "period_seconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "maximum_queries": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "previous_query_counts": {
          "type": "object",
          "required": ["user", "ip"],
          "properties": {
            "user": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "ip": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "decision": {
          "enum": [
            "allowed",
            "rejected",
            "not_applicable",
            "not_evaluated"
          ]
        },
        "reason": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },

    "database": {
      "type": "object",
      "required": [
        "connections_selected",
        "health_checks",
        "operations"
      ],
      "properties": {
        "connections_selected": {
          "type": "array",
          "items": {"$ref": "#/$defs/database_connection"}
        },
        "health_checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/database_health_check"}
        },
        "operations": {
          "type": "array",
          "items": {"$ref": "#/$defs/database_event"}
        }
      },
      "additionalProperties": false
    },
    "database_connection": {
      "type": "object",
      "required": ["connection", "database", "status"],
      "properties": {
        "connection": {"type": "string"},
        "database": {"type": ["string", "null"]},
        "cluster": {"type": ["boolean", "null"]},
        "status": {
          "enum": ["selected", "connected", "failed", "unknown"]
        },
        "pool": {
          "type": ["object", "null"],
          "properties": {
            "max_pool_size": {"type": ["integer", "null"]},
            "min_pool_size": {"type": ["integer", "null"]},
            "server_selection_timeout_ms": {"type": ["integer", "null"]},
            "connect_timeout_ms": {"type": ["integer", "null"]},
            "wait_queue_timeout_ms": {"type": ["integer", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "database_health_check": {
      "type": "object",
      "required": ["connection", "status"],
      "properties": {
        "connection": {"type": "string"},
        "database": {"type": ["string", "null"]},
        "status": {
          "enum": ["success", "failed", "timeout", "not_attempted"]
        },
        "duration_ms": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "error_type": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "database_event": {
      "type": "object",
      "required": [
        "connection",
        "operation",
        "status",
        "duration_ms"
      ],
      "properties": {
        "connection": {"type": "string"},
        "database": {"type": ["string", "null"]},
        "operation": {"type": "string"},
        "collection": {"type": ["string", "null"]},
        "query_fingerprint": {"type": ["string", "null"]},
        "status": {
          "enum": ["success", "failed", "timeout", "cancelled"]
        },
        "duration_ms": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "records_returned": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_type": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/execution_event"}
        }
      },
      "additionalProperties": false
    },
    "execution_event": {
      "type": "object",
      "required": ["sequence", "name", "status", "started_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "name": {"type": "string"},
        "status": {
          "enum": [
            "started",
            "success",
            "failed",
            "skipped",
            "cancelled",
            "timeout"
          ]
        },
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "duration_ms": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "details": {"type": "object"},
        "error_type": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["status_code"],
      "properties": {
        "status_code": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "response_type": {"type": ["string", "null"]},
        "exists": {"type": ["boolean", "null"]},
        "total_results": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "returned_results": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "returned_granularity": {"type": ["string", "null"]},
        "returned_schemas": {"type": "array"},
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "validation_status": {
          "enum": ["success", "failed", "not_attempted", null]
        },
        "serialization_status": {
          "enum": ["success", "failed", "not_attempted", null]
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": ["object", "null"],
      "required": ["type", "stage"],
      "properties": {
        "type": {"type": "string"},
        "code": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]},
        "stage": {"type": ["string", "null"]},
        "http_status": {"type": ["integer", "null"]},
        "expected": {"type": ["boolean", "null"]},
        "stack_trace_reference": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "environment",
        "application_version",
        "instance_id",
        "process_id"
      ],
      "properties": {
        "environment": {"type": ["string", "null"]},
        "application_version": {"type": ["string", "null"]},
        "instance_id": {"type": ["string", "null"]},
        "process_id": {"type": ["integer", "null"]},
        "python_version": {"type": ["string", "null"]},
        "application_state": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["persistence_status"],
      "properties": {
        "persistence_status": {
          "enum": ["pending", "success", "failed", "partial"]
        },
        "record_hash": {"type": ["string", "null"]},
        "previous_record_hash": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
